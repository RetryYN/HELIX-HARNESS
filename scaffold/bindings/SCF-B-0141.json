  "role": "legacy-config-product-boundary-research-0141-static",
  "obligations": [
    "固定BASEのlegacy dispositionからconfig/** exact 41 asset ID/pathを独立再導出し欠落・重複・余分を拒否する",
    "41件すべての固定BASE config本文を具体semantic spanとして手動pinし、意味・candidate product L1・counterevidence・bootstrap一致/不一致を保持する",
    "各archive configuration sourceのGit ls-tree mode=100644/type=blob/path exact、blob/bytes/SHA、MANIFEST/ledger digest、semantic span、1-based inclusiveで計算したanchor外の行範囲を保持し、全文読了を主張しない",
    "implementation status、未実装・不足証拠、degradation/failure、consumer、decision/read-after、Wave edgeを分類候補から分離する",
    "origin/main 7afee33aeの8 inventory union 429と、統合済み#2078 SCF-B-0126の新規67 recordsをasset IDで結合してcurrent research union 496を再導出し、config target41との重複0・統合後537を固定する",
    "旧archive source/runtime/test/hook/adapter/CI/workflowは実行せず独立validator/selfcheck/scfctlを維持する",
    "Binding upstreamをmanifestを除く65 fixed nonarchive inputsと、8 current-main research inventoriesおよび統合済みSCF-B-0126の67-record ledgerへ完全閉包する"
  ],
  "connections": {
    "consumers": [
      "parent legacy product-classification research ledger",
      "human review handoff after author validation"
    ],
    "dependencies": [
      "fixed BASE phase/disposition/decision/read-after snapshots",
      "approved four-product L1 and product-boundary",
      "Wave1-50 static snapshots",
      "origin/main 7afee33ae: eight research inventories union 429 plus merged SCF-B-0126 67-record ledger (authoritative union 496)"
    ],
    "boundary": "research evidence only; no formal product, phase, implementation, successor, or authority"
  },
  "operations": {
    "allowed": [
      "read fixed BASE and archive bytes statically",
      "write scaffold bundle and Binding",
      "run deterministic generator/validator/selfcheck/scfctl"
    ],
    "forbidden": [
      "execute archive legacy source/runtime/test/hook/adapter/CI",
      "promote candidate to formal owner/phase/successor/implementation",
      "modify existing ledgers or Wave snapshots",
      "merge/close/deploy"
    ]
  },
  "artifacts": [
    "scaffold/bindings/SCF-B-0141.json",
    "scaffold/legacy-config-product-classification-0141/README.md",
