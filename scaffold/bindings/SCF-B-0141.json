    "negative_cases": [
      "target omission/duplicate/extra",
      "manual semantic profile/category/product/meaning/counterevidence tamper",
      "source blob/SHA/semantic span/coverage/MANIFEST/ledger tamper",
      "archive symlink/nonregular/path mismatch",
