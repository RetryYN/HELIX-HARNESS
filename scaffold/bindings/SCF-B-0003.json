      "python3 -B scaffold/review-handoff/gui_selftest.py",
      "configure_gui.py --audit（外部所有hookの残留検査）",
      "configure_gui.py --rearm --apply（Claude所有ConfigChange metadataによる既存GUI待受回復）"
