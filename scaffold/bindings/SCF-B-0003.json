  "role": "共通規則・対象revisionを固定した通知を既存VS Code GUIの両レーンへ届け、明示ACKと応答対応を確認する",
  "obligations": [
    "規則と候補参照を種別とdigestで区別する",
    "base／content SHA、request identity、payload digestを照合する",
    "既存GUIのruntime・session・レーン・有効期限へ宛先を固定する",
    "queued／claimed／ackedを分離し、重複・別session・期限切れを拒否する",
    "未ACK時の明示retry、watcher世代、応答の逆方向配送を扱う",
    "通知から要求採否・承認・review完了・merge許可を生成しない",
    "設定撤去と両GUIのlive ACK未確認を追跡する"
  ],
  "connections": {
    "consumers": [
      "Claude／Codex作成側とreview側",
      "AIレーン引継ぎ #1864、推進 #1859、検収 #1860",
      "差し替え台帳 #1866"
    ],
    "dependencies": [
      "Python標準library",
      "読み取り専用Git",
      "SCF-B-0002の仮ルール集index",
      "同じVS CodeのClaude Code／Codex拡張のnative hook",
      "Linux file lockと共有のscaffold通知箱"
    ],
    "boundary": "scriptと通知stateはscaffold内。configure_guiだけが利用者のClaude settingsとCodex hooksへ本仮設参照を追加・撤去する。trustと権限を変更しない"
  },
  "operations": {
    "allowed": [
