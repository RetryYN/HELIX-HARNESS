  "approved_requirement_meaning": {
    "l3_obligation": "推進はOSが担い、HARNESSが工程と検証義務、INTELLIGENCEが案、LABOが水準、SECURITYがauthority、INFRASTRUCTUREが資源を持つ。ticketとIssue/PR projection、仕事の意味とassignment/attempt/測定を分け、案やclose/mergeを実行/完了へ昇格しない。",
    "l10_obligation": "各判断の出所と対象scopeが別に辿れる。 / 越境を拒み、既存ownerと該当契約へ戻す。",
    "derived_boundary": "OS drives work while other owners retain their meaning and responsibilities; ticket/Issue/PR projection and work meaning versus assignment/attempt/measurement remain separate. This does not authorize the OS to assume another owner’s domain decision."
  },
  "l4_rule_basis": {
    "source_unresolved": "A single unknown comparison operand produces source_unresolved at its original pointer. This diagnostic code maps to the comparison facet; the comparison table selects workflow for authority/resource fields.",
    "authority_resource": "Compare authority/resource source_ref with independent context references. `current` and `observed_material` are accepted states; a null source_ref is unknown rather than a conflict.",
    "dedup": "Deduplicate only by code, pointer, and return_owner.",
    "aggregation": "Facet and whole condition prioritize violation, then unknown, then corresponding. No violation is derived by either single unresolved comparison.",
    "fixed_effect_boundary": "Actual effect flags stay false and operation_effect is none."
  },
