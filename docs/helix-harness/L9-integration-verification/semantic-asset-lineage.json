  "evidence_contract": {
    "binding": "同request revision/scope/source snapshotにID/semantic revision/location/relation/endpoint/history/authority/oracle/typed edgeを結び、原因と返却ownerを個別観測する。",
    "negative": "各mutationを独立入力へ。対象外記録/根拠は正例固定。未知軸、原ID/revision、affected relation、差分、ownerとoperation heldを比較し、全部同じunknownだけで合格にしない。 各negativeのexpected_record_axes/expected_claim_state/expected_operation_state/expected_operation_selection/expected_reference_stateを個別assertする。記載外のsubject/axisは正例を保持。operation fieldは実操作の要求についてで、record_comparisonの照合をheldへしない。",
    "metamorphic": [
      "同snapshotの記録到着順を反転→同結果/source所属。",
      "path/nameだけ変更→同ID/意味revision、location履歴だけ差分。",
      "LS authorityだけmissing→当該authority軸だけmissing、LM/LXやoracle/edgeの既知状態を破棄しない。"
    ],
    "not_substitutes": [
      "path/name一致",
      "body hash一致/差",
      "fixture/receipt存在",
      "実保存/権限の自己申告",
      "旧runtime/CI/test合格"
    ],
    "state_definition": "原記録axisの状態と成立claimの状態は別field。owner-qualifiedな既知値/境界とclaimが矛盾すればclaim conflict、必要根拠がmissing/unknownで真偽を判定できなければclaim unknown。未知に対する自己申告でmatchedにしない。確定したA/B別IDを同一とするclaimはconflict。実保存/rollback/権限/受入は記録照合で証明できないためclaim unknown、純粋結果から成立させない。原記録の既知axisまでclaimの未知で上書きしない。"
  },
  "completion": {
    "execution_state": "not_executed",
    "document_static": "6pair/source pins/旧asset digest/負例分類と対応を静的照合、意味充足は独立reviewへ。",
    "not_proven": [
      "実owner source/資格/履歴resolver",
      "正式schema/採番/符号化/永続化",
      "L5/L8・L6/L7凍結/Red/Green・実L9/L10・CI",
      "PO受入/通常L3/release/deploy"
    ]
  }
}
