{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "helix hook work-guard",
            "timeout": 5,
            "blockOnFailure": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "helix hook machine-safety-guard",
            "timeout": 5,
            "blockOnFailure": true
          },
          {
            "type": "command",
            "command": "helix hook git-command-guard",
            "timeout": 5,
            "blockOnFailure": true
          }
        ]
      }
    ]
  }
}
