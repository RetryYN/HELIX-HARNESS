  "architecture": {
    "components": [
      "selected_recipient_closure_comparer",
      "recipient_delivery_application_comparer",
      "local_unknown_isolation_recovery_comparer"
    ],
    "flow": [
      "trigger分類の原素材と独立期待 → 安全通知/一般meaning通知の分離",
      "policyと独立sourceの該当recipient exact set → 各recipient identity/命令/受領/適用素材の別照合",
      "隔離before-state/復旧素材 → 同event/operation/scopeで別照合。復旧素材一致から自動resumeを生成しない。"
    ],
    "pure_boundary": "SECはpolicy/発火条件だけ。OS/Worker/CONNECT/credential/artifact/INFRAは自身のstate/実enforcementを保持。本readerはsource資格を持たない値なし比較。",
    "phase_boundary": "dispatchは命令素材、receivedは同eventの受領素材、appliedは実適用とpost-state/隔離素材、recoveryはさらに原前状態への復旧素材。未来の受領/適用/復旧をdispatchの一律gateにしない。",
    "locality": "general_meaningが独立期待と一致したときだけこの通知から局所停止を要求しない。安全分類不明/相反は当該identity不足を保持し全scope停止へ補完しない。",
    "independent_recovery": "INFRA010-F06等の独立復旧経路は該当recipient選択条件に従い、停止中OS/通常009応答を必須化しない。"
  },
