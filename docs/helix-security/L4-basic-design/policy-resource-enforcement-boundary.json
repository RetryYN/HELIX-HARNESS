  "contracts": [
    {
      "id": "HELIXSECURITY-L4-024-B01",
      "requirement_ref": "HELIXSECURITY-L3-024-B01",
      "oracle_ref": "HELIXSECURITY-L10-024-B01",
      "source_obligation_value": "INFRAの通常資源状態/backup/snapshotへcredential値を無条件保存せず、SECの既存005方針と安全な実資源境界を照合する。024の歴史Stage4を保持し、初回必要な安全接続規範だけ先行著述する。",
      "source_oracle_values": {
        "positive_input": "通常資源record/backup/snapshotと値非露出の安全境界を合成参照で照合する。",
        "expected_observation": "policy owner/実資源owner/enforcerと証拠custodyが分かれ、値を通常証跡へ出さない。",
        "negative_input": "通常snapshotにraw値、OSが資源authority代替、Stage4全能力前倒し。",
        "failure_observation": "当該保存/回収不足をSEC/INFRAへ返し、実許可設定を本文から変更しない。"
      },
      "obligation_breakdown": [
        "通常の資源状態・backup・snapshotにraw credential値を無条件保存しない。",
        "SECURITY-L2-005の既存credential方針とINFRASTRUCTUREの安全な実資源境界を照合する。",
        "歴史Stage 4の範囲を保持し、初回に必要な安全接続規範だけを前に置く。"
      ],
      "rule": "SECURITYがcredential方針を所有し、INFRASTRUCTUREの通常資源record/backup/snapshotは値そのものではなく必要な資源参照・状態を保持する。Worker実行環境が適用境界を担い、通常証跡のcustodyは資源観測側へ結ぶ。初回著述の対象を安全接続の必要規範に限り、Stage4の全能力が成立したとは扱わない。",
      "source_trace": [
        "HELIXSECURITY-L3-024-B01",
        "HELIXSECURITY-L10-024-B01"
      ],
      "failure_route": "当該保存または回収不足をSECURITY/INFRASTRUCTUREへ返す。文書から実許可設定を変更しない。"
    },
    {
      "id": "HELIXSECURITY-L4-024-F01",
      "requirement_ref": "HELIXSECURITY-L3-024-F01",
      "oracle_ref": "HELIXSECURITY-L10-024-F01",
      "source_obligation_value": "SECのnetwork/credential/environment/project-isolation/operation-authority/update/egress policyと、INFRAの実資源/環境/状態、Workerの実強制を同revision/scopeへ照合する。実施状態・観測・失敗/不明のreceiptをpolicyへ結ぶ。",
      "source_oracle_values": {
        "positive_input": "policy受渡しと実適用状態を照合し、一境界未適用/unknownを与える。",
        "expected_observation": "宣言と実適用/未観測が別に辿れる。",
        "negative_input": "policyだけで資源安全、INFRAがpolicy発行、SECが資源配置、別環境receipt。",
        "failure_observation": "policy意味差はSEC、資源/実適用差はINFRA/実環境へ返し、OS作業状態へ混ぜない。"
      },
      "obligation_breakdown": [
        "SECURITYのnetwork/credential/environment/project-isolation/operation-authority/update/egress policyを結ぶ。",
        "INFRASTRUCTUREの実資源・環境・実際の状態を同revision/scopeで照合する。",
        "Worker実行環境の物理強制と、実施状態・観測・失敗/不明receiptをpolicyへ結ぶ。"
      ],
      "rule": "合成照合でSECURITY宣言、INFRASTRUCTUREの資源・環境状態、Worker実行環境の強制を、対象revision/scope/environmentの明示値で結ぶ。宣言と実適用は別の事実として保持し、観測済みの値はknownのまま、未観測/失敗した境界だけを未成立として示す。INFRASTRUCTUREにpolicy発行やSECURITYに資源配置の権限を与えず、OS作業状態へ資源/authority truthを混ぜない。",
      "source_trace": [
        "HELIXSECURITY-L3-024-F01",
        "HELIXSECURITY-L10-024-F01"
      ],
      "failure_route": "policy意味差はSECURITYへ、資源状態/実適用差はINFRASTRUCTURE/実環境へ返す。OS作業状態へ混ぜない。"
    }
  ],
