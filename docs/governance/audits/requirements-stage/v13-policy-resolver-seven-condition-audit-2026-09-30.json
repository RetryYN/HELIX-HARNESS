        "source_line_sha256": "sha256:629e5000340eca7dd35e32e48b8c8a11c29f526f4b78d5459b529f15ab09cbe2",
        "source_text": "requirements-ownedなversioned policyを一方向導出し、signal文字列や旧`mode`からcommandを直接選ばない。",
        "condition_cluster_id": "V13-COND-L0155",
        "source_section_group": 10,
        "source_section_label": "§4.2.2 execution policy・152–183"
      },
      "baseline_queue_status": "partial",
      "queue_priority": "primary_residual",
      "local_individual_audit_refs": [],
      "later_adopted_source_citation_refs": [],
      "clauses": [
        "確定済み`target_axis`と`target_id`から、requirements-ownedのversioned policyを一方向に導出する。signal文字列や旧`mode`からcommandを直接選ばない。"
      ],
      "f6_retained": [
        "SECURITY-008はoperation-specific authority tupleを照合し、未許可／unknown／staleな操作を通さない。SECURITY-007はWorker環境制約の適用と観測を要求する。"
      ],
      "f6_difference": [
        "固定pairはrequirements-owned policy projection、target_axis/target_idからの導出、signal／旧mode禁止を定義しない。"
      ],
      "unresolved": [
        "target_axis/target_idの正本owner・revision、policy versionとprojectionの同期、exact derivation/receipt trace、signalや旧modeを排除するconsumer判定。"
      ],
      "counterexamples": [
        "signal名だけからcommandを選択する。",
        "旧`mode`をpolicyのsource of truthとして利用する。",
        "target identity未確定のままpolicyを推定しresolvedにする。"
      ],
      "later_pair_effects": {
        "SECURITY-032": "permanent repository bypass denyの優先順位だけ。policy導出元の決定ではない。",
        "SECURITY-034": "選択済みMCP profile内のtool capability・probe・authority条件だけ。一般workflowのpolicy projectionではない。",
        "HARNESS-052": "同じcommand IDの意味payload/replay判定だけ。policyのrequirements-owned導出やlegacy-field排除ではない."
      },
      "successor_assignment": "none",
      "adoption_by_this_audit": false,
      "source_condition_closed": false
    },
