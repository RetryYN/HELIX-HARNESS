      "source_line_sha256": "6d876a5a9a98a8da8008cc56d5b73f5d1bfe5f06c31891ef89c1d489c57215a2",
      "source_text": "compatibility inventoryの成功でcurrent projectionの欠落、drift、invalidを相殺してはならない。"
    },
    {
      "position": 25,
      "source_item_id": "REQSRC-SUP-00105",
      "source_path": "archive/legacy-generation-2026-09-14/root/docs/governance/helix-harness-requirements_v1.3.md",
