  "corrected_positions_21_40": [
    {
      "position": 21,
      "source_item_id": "REQSRC-SUP-00077",
      "source_path": "archive/legacy-generation-2026-09-14/root/docs/governance/helix-harness-requirements_v1.3.md",
      "source_file_sha256": "788636a30b5950b8d8d5f663018786e7071e4a06c4bb77688c5c9100e80a7406",
      "source_line": 102,
      "source_line_sha256": "6410ee034dc29f92ad47d40149e59102a06c891dfa043129afaff1fffe4da6f0",
      "source_text": "`SCRUM_REVERSE`は `SR0 evidence capture → SR1 observed contract → SR2 V-layer mapping → SR3 design/refactor proposal → SR4 pair freeze and Forward reentry` の5段階とする。SR4 receiptなしにsliceをrelease-readyにしない。Reverseが作るのは実装の説明書ではなく、次の変更を拘束できる要求・要件・基本設計・詳細設計・test/verification/measurement contractである。"
    },
    {
      "position": 22,
      "source_item_id": "REQSRC-SUP-00081",
      "source_path": "archive/legacy-generation-2026-09-14/root/docs/governance/helix-harness-requirements_v1.3.md",
      "source_file_sha256": "788636a30b5950b8d8d5f663018786e7071e4a06c4bb77688c5c9100e80a7406",
      "source_line": 107,
      "source_line_sha256": "58faca77338462e4f086790d18f7e61135a0d0af6ce766aa8de67b7dfb28d91a",
      "source_text": "正本FR＝`docs/design/helix/L3-requirements/scrum-reverse-entity-model.md`（SRV-FR-101〜112）、"
    },
    {
      "position": 23,
      "source_item_id": "REQSRC-SUP-00089",
      "source_path": "archive/legacy-generation-2026-09-14/root/docs/governance/helix-harness-requirements_v1.3.md",
      "source_file_sha256": "788636a30b5950b8d8d5f663018786e7071e4a06c4bb77688c5c9100e80a7406",
      "source_line": 119,
      "source_line_sha256": "b8d0bd53395b0c57bf8aed4d6007d792e7aa0e7038480f0880754e0a2d22f0d6",
      "source_text": "Design Refactorはsemantic similarity、consumer、oracle、dependency graphで判断し、名称類似だけで統合しない。Performance Refactorは変更前baseline、budget、workload、profile、統計条件、回帰oracleを先に凍結し、測定不能な「高速化」を禁止する。どちらも機能追加と同一episodeへ混載しない。"
    },
    {
      "position": 24,
      "source_item_id": "REQSRC-SUP-00097",
      "source_path": "archive/legacy-generation-2026-09-14/root/docs/governance/helix-harness-requirements_v1.3.md",
