  "review_semantics": {
    "025": {
      "finding": "gap",
      "summary": "固定L2-025はHELIX自身と性質の異なる複数projectについて各々端から端運転を説明・統制する。正常CASE-025-01と-13はそれぞれHELIX＋単一の異種projectのpairで、-048全体正常は7製品unit/connection/compositeのみで複数projectの同一fixture traceを固定しない。-033〜039の7 stage single-mutationは全てCASE-025-01のHELIX側連鎖だけを変え、project-side stage completeness mutationがない。従って複数の異種projectを同時に扱う場合に一projectのticket/Worker/検収/operation/LABO/OS-returnを欠いても他project又はHELIX traceで代替されて成立とする偽成功を、CASE inventory単独変異で排除できない。",
      "evidence": [
        "L2-025 fixed input/output and return: L2 span",
        "L11-025 success/contradictions: L11 span",
        "FR AC-025-01: FR Stage5 section",
        "FV CASE-025-01,-13,-33..39,-48..49: FV Stage5 section",
        "NFR-025-01 inventory lists trace fields and deficits but not project-multiplicity fixture"
      ],
      "legacy_search": {
        "query": [
          "統合運転",
          "統合運転構成体",
          "HELIX-OS統合"
        ],
        "scope": [
          "archive/legacy-generation-2026-09-14/root/docs/design/helix/L3-requirements",
          "archive/legacy-generation-2026-09-14/root/docs/test-design/helix",
          "archive/legacy-generation-2026-09-14/root/docs/process/forward"
        ],
        "result": "no matches; limited to those paths/terms, so not proof the legacy meaning/source is absent"
      },
      "minimal_candidate": "複数の異種projectを同一正常fixtureに含め、project単位で値/直前source一致を検査する。さらにその正常baselineから、projectの一つの7段fieldだけを欠く各独立mutationを作り、該当source/unit ownerへの返却と他project/HELIX状態保持を確認する。要求meaning/owner/versionは変更しない。修正は未実施。",
      "confidence": "high"
    },
    "026": {
      "finding": "no_concrete_gap_found_in_scope",
      "summary": "固定L2-026の導出入力、candidate set/除外、機能/安全依存closure、最小性未立証の区別、実構成受入との分離をFR AC-01..05とFV CASE-01..60で具体化。source identity/revision、HARNESS version/compatibility、recovery/permission/owner/human process、通常/安全依存のmissing/unknown/stale/conflict、空pack候補除外、scope/boundary/適格性/入出力/update/rollback/resource/verification failure、pack version/target/output-routeの個別変異と既存owner返却がある。固定されない数値・pack/stage数・最小標本閾値を成功条件にしていない。",
      "case_scope": "FV CASE-026-01..60; NFR fixture table; BR/BV only trace functional inventory, no separate business oracle."
    },
    "031": {
      "finding": "no_concrete_gap_found_in_scope",
      "summary": "固定L2-031のrun/source/base、required selected/skipped digest、環境/profile/toolchain/platform/lockfile/artifact/cache/resource、interval/exit/output、population/period/exclusion、performance budget basisの入力fieldをFRへ保ち、AC-01/05およびFV 08..24/52..63/74..95で測定値・母集団・根拠の欠落/不一致を個別化。正しさ対性能、非縮退改善、escaped defect/mutation/flake、lease/fence/artifact/fallback/DAG/cancel/exactly-once/causal traceのCASEがある。旧60s/3mは固定環境比較値と明記され、CASE-031-088のfixture数値も運用閾値でないと明記。CASE-031-25 aliasと誤引用4件の除外もsync。",
      "case_scope": "FV CASE-031-01..95 except 066/068/070/072; 025 alias 006; alias not a unique denominator."
    },
    "047": {
      "finding": "no_concrete_gap_found_in_scope",
      "summary": "immutable元revision、理由/条件/source-revision/evidence、issuer、old assignment/result/authority noninheritance、provider-only operational difference、typed relation/未完義務の追跡、ticket/artifact両方向参照禁止をFRに定義。FV CASE-01..41でreason/evidence/source/revision/issuer/scope/relation/assignment/obligationの単独missing/unknown/conflict、old revision preservation and new revision, proposal-only issuance, issue/PR false closure, both reference directions、normal return split for worker-input vs inspection-oracle insufficientを記述。ownerはOS issuerまたは元source/authority既存ownerへ戻す。未根拠のKPI/graph/relation型なし。",
      "case_scope": "FV CASE-047-01..41; CASE-020 alias of provider-only CASE-004 and excluded from unique denominator."
    }
  },
  "limitations": [
    "文書内に記述されたCASE定義の意味のみを監査した。CASEを実行していない。",
    "他のStage/parent、実runtime/CI/consumer、実装状態、operation evidenceは未確認。",
    "025のproject-multiplicity gapの可能性は、固定L2の「複数project」解釈と現CASEの実fixture scopeを照合した限定所見。要求意味変更ではなくfixture coverage不足候補であり、本文修正は実施していない。",
    "旧sourceはここにpinしたrangeだけ実読。025の旧個別要件またはpaired consumerは確認できず、limited exact phrase search以上の意味不存在を主張しない。",
    "PO approval record, prior audit/approval, current body hashes, and semantic reading are distinct evidence types."
  ]
}
