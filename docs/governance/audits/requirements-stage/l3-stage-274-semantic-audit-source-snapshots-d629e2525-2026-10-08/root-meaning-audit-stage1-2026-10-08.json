  "findings": [
    {
      "id": "CONNECT-001-applicable-id-coverage",
      "assessment": "bounded potential coverage gap; root meaning determination needed",
      "locators": "fixed L2 connect-requirements.md:62-65; L3 functional-requirements.md:21-45; L10 functional-verification.md:25,32-39; fixed L11 connect-acceptance.md:42-45",
      "detail": "L2-001 input includes applicable SECURITY permission and data-use/classification identifiers; L3 common binding says applicable identifiers are passed. CASE-001-01 normal fixture does not explicitly include them and its independent negative list does not mutate an applicable identifier missing/unknown. Failure return for registration is generic source/consumer owner. This leaves a bounded path where an applicable identifier could be absent and registration appear usable. These are references to pass/trace, not a requirement to authorize send at registration. L2 says applicable IDs are input; L11-001 complete descriptor list omits these IDs, so do not strengthen registration authority without resolving this ambiguity."
    }
  ],
  "coverage": {
    "HARNESS": "010: owner/manifest/runtime dependency, single replacement/recovery, version/maturity separation; 011: environment-independent invocation, scope/authority, correlation, resume/expiry; 023: four classes, operation/source conditions, true/false/unknown/contradiction, fallback/reference-only/safety/human delegation/determinism. Unseen positives include multi-release component/core, other provider/tenant and explicit new source input.",
    "CONNECT": "001: unique registration, endpoint sharing distinction, no approval/permission creation; 002: read-only compatibility vs send authority; 003: bound envelope and incomplete handoff; 004: retry classification/limits/digest; 005: append-only ordered trace/payload exclusion. Unseen descriptor/revision/envelope/event positives present. See bounded finding for applicable IDs in 001."
  },
