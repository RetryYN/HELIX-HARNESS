  "semantic_review": [
    {
      "parent": "040",
      "status": "candidate_oracle_clarity_finding",
      "basis": "Fixed L11 specifies policy revision, initial-attempt counting semantics, failure classes, N and same-semantics attempt events. FR-040-01/02 and CASE-040-01/02 say configured cap and values missing/changed, but do not explicitly state the normal expected count semantics or each semantic mutant.",
      "potential_false_success": "If the active policy counts the initial attempt but the implementation counts retries only, it may allow one extra retry before typed return. Whether the generic “value changed” fixture catches this is unclear.",
      "classification": "Do not infer L2 meaning change; root should determine whether existing fixture intent proves this, and if not make a minimal L10 oracle clarification."
    },
    {
      "parent": "041",
      "status": "no_confirmed_gap",
      "basis": "Current canonical source/revision, coordination-only scope, forbidden carryover, conflict/unknown owner return and unrelated work continuation trace to fixed L2/L11 and old IPC-R07 source."
    },
    {
      "parent": "042",
      "status": "no_confirmed_gap",
      "basis": "Strict schema and payload digest, selected contract applicability, HARNESS oracle, no OS-issued schema/oracle/authority, and exact-scope/revision revalidation receipts are represented in AC/CASE normal and independent negatives."
    },
    {
      "parent": "043",
      "status": "no_confirmed_gap",
      "basis": "Request-required versus request-free normal operations are both explicit; event absence/mismatch, ACK, tool-call permission, result completion/write authority and unresolved Node-only authority are separately handled."
    },
    {
      "parent": "044",
      "status": "no_confirmed_gap",
      "basis": "Prose-only handover remains open; unknown/stale/conflict is finding-local and existing-status-only. Broader lifecycle and source-head mismatch remain outside the parent."
    }
  ],
