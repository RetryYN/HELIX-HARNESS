  "trace_changes": [
    {
      "file": "docs/helix-os/L3-requirements/functional-requirements.md",
      "change": "FR-033 input now explicitly carries selected detector-to-engine/output-kind applicability; AC-033-02 rejects individual missing/mismatch and routes detector declaration defects to detector meaning owner, OS receipt-only defects to OS registration receipt owner."
    },
    {
      "file": "docs/helix-os/L10-verification/functional-verification.md",
      "change": "Existing CASE-033-02 adds three isolated mutations (declaration missing, declared target mismatch, correct declaration but OS receipt missing/mismatch); every other field/input stays valid and no full-scope reproduction claim is accepted."
    },
    {
      "file": "docs/helix-os/L3-requirements/nfr-grade.md",
      "change": "NFR-033 candidate observes declaration/selected target/OS receipt consistency and does not count absent or misbound applicability as reproduction success; no new numeric threshold."
    },
    {
      "file": "docs/helix-os/L10-verification/nfr-verification.md",
      "change": "NFRV-033-01 measures those existing-contract failure modes and cause-specific return counts."
    },
    {
      "file": "docs/helix-os/L3-requirements/business-requirements.md",
      "change": "BR-033 keeps no quality KPI while tracing OS registry/provenance responsibility."
    },
    {
      "file": "docs/helix-os/L10-verification/business-verification.md",
      "change": "BIZ-033 retains selected-scope reproduced vs unevaluated distinction; bad applicability remains unevaluated and returns to existing owner."
    }
  ],
