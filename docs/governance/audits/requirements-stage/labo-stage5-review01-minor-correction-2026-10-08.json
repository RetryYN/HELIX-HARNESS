  "minor_dispositions": {
    "M1": {
      "status": "addressed",
      "change": "AC-04, NFR grade, L10 NFRV, and CASE-131/132 now cite fixed L2-068 original “定義しない”, existing FR-LABO-068-03 derivation to generation prohibition, fixed 070 9-atom scope, and L11-070 no-rate boundary when numerator/denominator applicability is unproven. No denominator/oracle/threshold/owner defined."
    },
    "M2": {
      "status": "addressed",
      "change": "AC-05 explicitly references CASE-131/132 and their preservation of normal 067/068 co-present fields; FV CASE rows already trace to AC-04 and AC-05."
    },
    "M3": {
      "status": "addressed",
      "change": "071 CASE-r06 baseline and oracle both preserve each owner identity value or unknown state exactly as in baseline input."
    },
    "M4": {
      "status": "addressed",
      "change": "This addendum supplies repository-relative same-directory paths for old immutable semantic audit and pin/index correction records; original records remain unchanged."
    }
  },
