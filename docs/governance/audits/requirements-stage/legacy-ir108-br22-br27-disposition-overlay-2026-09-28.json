      "remaining_condition_atoms": [
        {
          "condition_key": "HIL-BR-22-R1",
          "source_clause": "要求系統とservice/capability系統をDesign Templateへ結び、各要求から生じる設計義務を原子的に生成・消込する。閉じた要求集合について説明のない設計漏れを0件にし、未知の要求まで網羅したとは主張しない。",
          "source_span_is_verbatim": true,
          "remaining_meaning": "固定したclosed scopeの全design obligationを原子的に消込んだ根拠と、説明のない漏れが0件である判定を行うgateが現行採択済み条項にない。一般的なunknown/stale可視化やrelation traceだけでは代替できない。",
          "unadopted_analogous_refs": ["HARNESS-L2-041", "HARNESS-L2-044"],
          "relation_limit": "041は別source HIL-FR-47、044は別source HIL-FR-54由来の未採択候補。いずれもHIL-BR-22のsuccessorまたは採択済み意味ではない。",
          "audit_basis": "legacy-ir108-br21-br22-br27-condition-audit-2026-09-28.md:34"
        }
      ],
      "formal_successor_ids": [],
