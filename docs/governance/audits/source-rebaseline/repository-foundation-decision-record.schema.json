{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RetryYN/HELIX-HARNESS/blob/main/docs/governance/audits/source-rebaseline/repository-foundation-decision-record.schema.json",
  "title": "Repository foundation human decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "allowed_post_decision_change_paths",
    "approved_scope",
    "authority_effect",
    "correction_of",
    "decided_at",
    "decision",
    "decision_id",
    "decision_packet_path",
    "decision_packet_sha256",
    "decision_payload_comment_id",
    "decision_payload_remote_body_sha256",
    "decision_payload_sha256",
    "decision_record_id",
    "decision_source_ref",
    "decision_text",
    "excluded_scope",
    "required_merge_method",
    "content_review_delivery_receipt_comment_id",
    "content_review_request_comment_id",
    "content_review_request_id",
    "content_review_response_comment_id",
    "content_review_result",
    "schema_version",
    "stop_conditions",
    "target_base_head",
    "target_base_ref",
    "target_content_head",
    "target_pr"
  ],
  "properties": {
    "schema_version": { "const": "repository_foundation_decision_record.v1" },
    "decision_record_id": { "type": "string", "pattern": "^HDECREC-REPOSITORY-FOUNDATION-[0-9]{3}$" },
    "decision_id": { "const": "HDEC-REPOSITORY-FOUNDATION-0.1" },
    "correction_of": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^HDECREC-REPOSITORY-FOUNDATION-[0-9]{3}$" }
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "decision": { "const": "approve_foundation" },
    "decided_at": { "type": "string", "format": "date-time" },
    "decision_text": { "type": "string", "minLength": 1 },
    "decision_source_ref": { "type": "string", "minLength": 1 },
    "target_pr": { "const": 1797 },
    "target_base_ref": { "const": "main" },
    "target_base_head": { "$ref": "#/$defs/git_sha" },
    "target_content_head": { "$ref": "#/$defs/git_sha" },
    "decision_packet_path": {
      "const": "docs/governance/audits/source-rebaseline/repository-foundation-human-decision-packet.md"
    },
    "decision_packet_sha256": { "$ref": "#/$defs/sha256" },
    "content_review_request_id": { "type": "string", "minLength": 1 },
    "content_review_request_comment_id": { "$ref": "#/$defs/github_id" },
    "content_review_delivery_receipt_comment_id": { "$ref": "#/$defs/github_id" },
    "content_review_response_comment_id": { "$ref": "#/$defs/github_id" },
    "content_review_result": { "$ref": "#/$defs/zero_findings" },
    "decision_payload_comment_id": { "$ref": "#/$defs/github_id" },
    "decision_payload_sha256": { "$ref": "#/$defs/sha256" },
    "decision_payload_remote_body_sha256": { "$ref": "#/$defs/sha256" },
    "approved_scope": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "archive_isolation",
          "physical_product_separation",
          "github_one_way_projection",
          "lossless_requirement_admission",
          "top_down_derivation_and_stop_conditions",
          "ai_new_generation_entry"
        ]
      }
    },
    "excluded_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_post_decision_change_paths": {
      "const": [
        "docs/governance/audits/source-rebaseline/repository-foundation-decisions.jsonl"
      ]
    },
    "required_merge_method": { "const": "merge_commit" },
    "authority_effect": { "const": "repository_foundation_approved" }
  },
  "$defs": {
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "github_id": { "type": "integer", "minimum": 1 },
    "zero_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "major", "minor"],
      "properties": {
        "blocker": { "const": 0 },
        "major": { "const": 0 },
        "minor": { "const": 0 }
      }
    }
  }
}
