  "responsibility_partition": {
    "candidate_normative_responsibility": "HARNESS candidate defines the meaning and acceptance boundary of atomic behavior decomposition: one behavior per child atom, source span, extractor version, optional parent aggregate, observed input/output/side-effect, and selected-scope denominator excluding parent aggregates and file classifications.",
    "existing_os_management_responsibility": "HELIX-OS retains original-source identity/revision/digest/authority, custody/provenance, management record and portfolio/evidence continuity under adopted HELIXOS-L2-015/016/019. Those records establish which source/scope is being managed; they do not establish behavior-atom semantics or atom coverage.",
    "candidate_does_not_transfer": "Source intake, authority, source custody, original-source preservation, or OS management records are not moved to HARNESS. HARNESS atomization does not make OS source authority or custody decisions.",
    "status": "proposed responsibility split only; no PO selection, successor assignment, owner change, source holding release, adoption, implementation, or execution.",
    "human_decision_options": {
      "A_recommended": "HARNESS owns behavior-atom semantics and oracle; OS retains original-source management/custody/provenance under existing OS requirements. This resolves the old routing split without transferring custody.",
      "B": "Keep both behavior-atom semantics and source management in OS; HARNESS-027/038/041 continue only their already adopted scopes and HARNESS-067 is not adopted.",
      "recommendation": "A as a proposal for PO decision, not as an accepted current assignment."
    }
  },
