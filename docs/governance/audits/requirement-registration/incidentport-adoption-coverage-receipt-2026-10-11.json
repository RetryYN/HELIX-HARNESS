    {
      "path": "docs/helix-harness/L2-requirements/product-requirements.md",
      "operation": "insert_after_exact_anchor",
      "before_file_sha256": "595e2258f00919e2730d894df9118fd58ef4920ce78e95a8de615fb09bfc9bc4",
