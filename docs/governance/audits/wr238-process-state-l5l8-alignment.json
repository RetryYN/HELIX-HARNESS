  "upstream_meaning": {
    "L3_pointer": "/requirements/66",
    "L3_id": "HARNESS-L3-003-F03",
    "L3_obligation": "005/015の凍結→実装前Red実観測→最小Green→局所Refactor/原子CIと双方向traceを同対象へ結び、出力をProvisionalにする。右側では結合scopeを広げるごとに実物を対設計へ照合し、L8↔L5/L9↔L4/L10↔L3を保つ。正規由来が分かる変更は当該scopeのScoped Reverse、由来不明/旧資産/trace欠落/設計を信用できない/大きなずれは全体Reverseの復旧候補に分ける。L9ではinterface、依存の向き、state/dataの所有、transaction、失敗伝播、retry、timeout、冪等性、結合度、責務重複を照合する。通常の照合ではticketを発行しない。明らかな設計/実装のずれ、由来欠落、同種findingの再発、性能退行、障害後の恒久対策、Scrum Reverse checkpoint、大きな設計退行ではReverse ticketの発行条件となる。小さな境界Refactorは現在のForward ticket内、独立した大きな構造/横断/architecture改善はRefactor/Design-refactor/Performance-refactor ticketへ区別する。HARNESSは条件と種類の意味を提供し、実発行はOSが所有する。",
    "L10_pointer": "/cases/66",
    "L10_id": "HARNESS-L10-003-F03",
    "L10_positive_input": "由来と対が明確な変更、由来不明/trace欠落、実装前Red不足を別々に照合する。通常照合と各Reverse trigger、局所/独立構造改善を分け、L9の各観点の不足を与える。",
    "L10_expected_observation": "谷の証拠条件と局所/全体照合の選択根拠が辿れ、原子CIを上位証明にしない。L9各観点とticket非発行/発行条件/種類の違いが辿れる。",
    "derived_semantics_pointer": "/contracts/3/connection_detail/partial_result_semantics",
    "blind_conclusion": "pair_result/valley_result値はsynthetic fixture conditionへのsource支持・fixture conflict/stale/missingを示すtyped expected partial statusであり、処理結果・finding・成功ではない。L9期待はflat projectionの未実行fixture record。"
  },
  "L5_F03_review": {
    "function_pointer": "/functions/3",
    "steps": [
      {
        "index": 0,
        "pointer": "/functions/3/internal_steps/0",
        "verdict": "独立raw source資格、005/015谷証拠、由来/trace/設計信頼、L9観測、trigger資料を分ける。L4型包絡とL3/L10要求に整合。"
      },
      {
        "index": 1,
        "pointer": "/functions/3/internal_steps/1",
        "verdict": "谷証拠のfreeze→実装前Red→minimum body→Green→refactor→atomic CI接続を要求。L3/L10の谷条件を保持。"
      },
      {
        "index": 2,
        "pointer": "/functions/3/internal_steps/2",
        "verdict": "双方向traceとrefactor前後意味保存を照合し、不足時はstate ceilingをnullにする。L4部分状態を上書きしない。"
      },
      {
        "index": 3,
        "pointer": "/functions/3/internal_steps/3",
        "verdict": "正規originはscoped候補、欠落・旧資産・trace等は復旧候補へ分ける。triggerのtrace包含意味は未決として保持。"
      },
      {
        "index": 4,
        "pointer": "/functions/3/internal_steps/4",
        "verdict": "3 pairを別々に比較し、集約未成立でも他pairを残す。L4部分結果/scope方針と一致。"
      },
      {
        "index": 5,
        "pointer": "/functions/3/internal_steps/5",
        "verdict": "L9の10観点を個別比較し、unknownを成功/空へ補わない。L4 unknown分類を保つ。"
      },
      {
        "index": 6,
        "pointer": "/functions/3/internal_steps/6",
        "verdict": "通常照合ticket noneと個別trigger/規模を分ける。origin-null triggerとtrace-emptyの差を保持し一般化しない。"
      },
      {
        "index": 7,
        "pointer": "/functions/3/internal_steps/7",
        "verdict": "意味保存refactorと独立改善候補、上流意味差のbackflowを分ける。L3/L10に整合。"
      },
      {
        "index": 8,
        "pointer": "/functions/3/internal_steps/8",
        "verdict": "candidate資料と実ticket/Reverse実行を分け、HARNESSによる発行を禁止。L4 actual_side_effect境界に整合。"
      },
      {
        "index": 9,
        "pointer": "/functions/3/internal_steps/9",
        "verdict": "L4 source-binding role、qualification sidecarとrequest association、raw return/private recordの分離。現行L4依存契約と一致。"
      },
      {
        "index": 10,
        "pointer": "/functions/3/internal_steps/10",
        "verdict": "missing/unknown/conflictを既存PartialValue依存にのみ伝播し、他roleの値で補わない。L4 failure propagationと一致。"
      },
      {
        "index": 11,
        "pointer": "/functions/3/internal_steps/11",
        "verdict": "valley/pair/L9/origin/trace/triggerを個別照合し、他pairを保持。部分結果保持と一致。"
      }
    ],
