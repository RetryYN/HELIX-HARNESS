        "R-F01-SOURCE-BINDING",
        "R-F01-FIELD",
        "R-F01-NAME"
      ]
    },
    {
      "name": "compare_f02",
      "signature": "compare_f02(input: ApplicabilityInput) -> ApplicabilityResult",
      "reads": [
        "input.original_condition.identity/meaning/required_input_identity/required_value/revision",
        "input.provided_condition: required member。明示null/objectのみ。member absentは型不一致; objectの上記5field",
        "input.product_input: required member。明示null/objectのみ。member absentは型不一致; object.identity/state/value",
        "input.claims_unknown_applicable",
        "input.claims_definition_missing_as_value_unset",
        "input.claims_existence_adopted",
        "input.claims_received_obligation_complete"
      ],
      "returns": [
        "definition_result",
        "product_input_result",
        "applicability_result",
        "proposal_state",
        "unfulfilled_contract_refs",
        "claim_results[4 keys]",
        "owner_return_candidates",
        "effects[9 false]",
        "unaffected_Q"
      ],
      "preconditions": [
        "入力はApplicabilityInputの閉じたshapeで、宣言済みroot memberはすべて必須。product_inputとprovided_conditionはmemberが存在する場合に限り明示nullを許す。member absentは入力shape不一致であり、null/definition_missing/unknownへ変換しない。original_conditionのnullと必須member欠落も本有限case外のshape不一致である。"
      ],
      "postconditions": [
        "R-F02の優先順で計算し、定義不足と値不足、提案と採用/義務を分離する。"
      ],
      "branches": [
        "provided_conditionの明示null/record。member absentは型検証不一致として計算branchに入れない。objectの5値一致/不一致",
