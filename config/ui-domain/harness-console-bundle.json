      "contrast_class": "wcag-2.1-aa（Q32 意識、実値は L10 確定）",
      "aria_required": [
        "CMP-status-badge: 色 + アイコン/ラベル併記（色のみに依存しない）",
        "CMP-copy-button: Tab フォーカス + Enter/Space 実行",
        "CMP-filter-bar: Tab フォーカス + Enter/Space 実行",
        "フォーカスリング維持（Desktop keyboard 利用者向け）"
      ]
    },
    "brand": {
      "tokens": [
        { "token_id": "TOK-state-color", "value": "light 固定（Q30）: ok=緑 / warn=黄 / error=赤 / empty=灰。hex 実値は L10 確定" },
        { "token_id": "TOK-typography", "value": "日本語固定（Q31）: 本文=可読日本語フォント / コード・CLI=等幅。実 font 名などの具体値は ui-element §3 冒頭注記（High-Fi 確定は L10 委譲）に従い持ち込まない" }
      ]
    },
    "revision": 1
  },
