{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix.local/schemas/requirement-ir.v1.json",
  "title": "HELIX Requirement IR canonical envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "source_authority",
    "partition",
    "shards",
    "baseline_root_digest",
    "root_digest"
  ],
  "properties": {
    "schema_version": { "const": "helix-requirement-ir.v2" },
    "authority": { "const": "canonical" },
    "source_authority": { "const": "json_stable_id_shards" },
    "partition": { "const": "stable_id_keyed_shards" },
    "shards": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/shard" }
    },
    "baseline_root_digest": { "$ref": "#/$defs/digest" },
    "root_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "count", "digest"],
      "properties": {
        "kind": {
          "enum": ["requirements", "system_contracts", "acceptance_cases", "system_tests", "refinement_contracts"]
        },
        "path": { "type": "string", "pattern": "^requirements-ir/[a-z_]+\\.json$" },
        "count": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "requirement_id",
        "revision",
        "kind",
        "status",
        "definition_status",
        "evidence_origin",
        "statement",
        "source",
        "assertion_id",
        "primary_system_contract_id",
        "acceptance_ids",
        "system_test_id",
        "downstream_obligation",
        "actor_ids",
        "task_ids",
        "surface_ids",
        "design_template_ids",
        "design_obligation_ids",
        "required_design_artifact_kinds",
        "pending_resolution",
        "semantic_digest"
      ],
      "properties": {
        "schema_version": { "const": "helix-requirement.v1" },
        "requirement_id": { "type": "string", "pattern": "^HIL-(BR|FR|TR|NFR)-[0-9]{2}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["business", "functional", "technical", "non_functional"] },
        "status": { "const": "specified" },
        "definition_status": { "const": "frozen" },
        "evidence_origin": { "const": "legacy_markdown_migration" },
        "statement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "semantic_digest"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "semantic_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_pointer", "migration_source_pointer", "authority_id"],
          "properties": {
            "canonical_pointer": { "type": "string", "minLength": 1 },
            "migration_source_pointer": { "type": "string", "minLength": 1 },
            "authority_id": { "type": "string", "minLength": 1 }
          }
        },
        "assertion_id": { "type": "string", "pattern": "^HIA-(BR|FR|TR|NFR)-[0-9]{3}$" },
        "primary_system_contract_id": { "type": "string", "pattern": "^HR-FR-HIL-[0-9]{2}$" },
        "acceptance_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^HAC-HIL-[0-9]{2}[abc]$" }
        },
        "system_test_id": { "type": "string", "pattern": "^HAT-HIL-[0-9]{2}$" },
        "downstream_obligation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["obligation_id", "owner_id", "status", "route_issue_ids"],
          "properties": {
            "obligation_id": { "type": "string", "pattern": "^DOWNSTREAM-HIL-" },
            "owner_id": { "type": "string", "pattern": "^HR-FR-HIL-[0-9]{2}$" },
            "status": { "const": "pending_pair_descent" },
            "route_issue_ids": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "actor_ids": { "type": "array", "items": { "type": "string" } },
        "task_ids": { "type": "array", "items": { "type": "string" } },
        "surface_ids": { "type": "array", "items": { "type": "string" } },
        "design_template_ids": { "type": "array", "items": { "type": "string" } },
        "design_obligation_ids": { "type": "array", "items": { "type": "string" } },
        "required_design_artifact_kinds": { "type": "array", "items": { "type": "string" } },
        "pending_resolution": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "systemContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_contract_id",
        "revision",
        "status",
        "requirement_ids",
        "behavior",
        "transition_contract",
        "failure_and_evidence",
        "acceptance_ids",
        "system_test_id",
        "semantic_digest"
      ],
      "properties": {
        "schema_version": { "const": "helix-system-contract.v1" },
        "system_contract_id": { "type": "string", "pattern": "^HR-FR-HIL-[0-9]{2}$" },
        "revision": { "const": 1 },
        "status": { "const": "specified" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^HIL-(BR|FR|TR|NFR)-[0-9]{2}$" }
        },
        "behavior": { "type": "string", "minLength": 1 },
        "transition_contract": { "type": "string", "minLength": 1 },
        "failure_and_evidence": { "type": "string", "minLength": 1 },
        "acceptance_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^HAC-HIL-[0-9]{2}[abc]$" }
        },
        "system_test_id": { "type": "string", "pattern": "^HAT-HIL-[0-9]{2}$" },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "acceptance_id",
        "revision",
        "status",
        "system_contract_id",
        "polarity",
        "statement",
        "system_test_id",
        "semantic_digest"
      ],
      "properties": {
        "schema_version": { "const": "helix-acceptance-case.v1" },
        "acceptance_id": { "type": "string", "pattern": "^HAC-HIL-[0-9]{2}[abc]$" },
        "revision": { "const": 1 },
        "status": { "const": "specified" },
        "system_contract_id": { "type": "string", "pattern": "^HR-FR-HIL-[0-9]{2}$" },
        "polarity": { "enum": ["positive", "negative", "boundary"] },
        "statement": { "type": "string", "minLength": 1 },
        "system_test_id": { "type": "string", "pattern": "^HAT-HIL-[0-9]{2}$" },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "refinementContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "refinement_contract_id",
        "revision",
        "lifecycle_status",
        "primary_system_contract_id",
        "related_system_contract_ids",
        "source",
        "plan_id",
        "responsibility_owner",
        "supporting_requirements",
        "acceptance_cases",
        "downstream_issue_ids",
        "approval",
        "semantic_digest"
      ],
      "properties": {
        "schema_version": { "const": "helix-requirement-refinement.v1" },
        "refinement_contract_id": { "$ref": "#/$defs/refinementId" },
        "revision": { "type": "integer", "minimum": 1 },
        "lifecycle_status": {
          "enum": ["draft", "specified", "approved", "frozen", "rejected", "superseded"]
        },
        "primary_system_contract_id": { "$ref": "#/$defs/systemContractId" },
        "related_system_contract_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/systemContractId" }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement_path", "requirement_digest", "acceptance_path", "acceptance_digest"],
          "properties": {
            "requirement_path": { "$ref": "#/$defs/refinementSourcePath" },
            "requirement_digest": { "$ref": "#/$defs/digest" },
            "acceptance_path": { "$ref": "#/$defs/refinementSourcePath" },
            "acceptance_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "plan_id": { "type": "string", "pattern": "^PLAN-[A-Z0-9-]+$" },
        "responsibility_owner": { "type": "string", "minLength": 1 },
        "supporting_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/refinementRequirement" }
        },
        "acceptance_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/refinementAcceptance" }
        },
        "downstream_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "approval": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/refinementApproval" }]
        },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "refinementId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "systemContractId": {
      "type": "string",
      "pattern": "^HR-FR-HIL-[0-9]{2}$"
    },
    "refinementSourcePath": {
      "type": "string",
      "pattern": "^docs/(design/helix/L3-requirements|test-design/helix)/[a-z0-9][a-z0-9._-]*\\.md$"
    },
    "refinementRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "statement", "acceptance_ids", "semantic_digest"],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/refinementId" },
        "statement": { "type": "string", "minLength": 1 },
        "acceptance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/refinementId" }
        },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "refinementAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_id", "requirement_ids", "polarity", "statement", "semantic_digest"],
      "properties": {
        "acceptance_id": { "$ref": "#/$defs/refinementId" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/refinementId" }
        },
        "polarity": { "enum": ["positive", "negative", "boundary"] },
        "statement": { "type": "string", "minLength": 1 },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "refinementApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "decision_source", "decision_digest", "source_set_digest", "candidate_head", "approved_revision", "approved_at"],
      "properties": {
        "authority": { "const": "PO" },
        "decision_source": { "type": "string", "minLength": 1 },
        "decision_digest": { "$ref": "#/$defs/digest" },
        "source_set_digest": { "$ref": "#/$defs/digest" },
        "candidate_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "approved_revision": { "type": "integer", "minimum": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "systemTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_test_id",
        "revision",
        "status",
        "system_contract_id",
        "acceptance_ids",
        "supporting_test_ids",
        "scenario",
        "required_evidence",
        "negative_boundary",
        "semantic_digest"
      ],
      "properties": {
        "schema_version": { "const": "helix-system-test.v1" },
        "system_test_id": { "type": "string", "pattern": "^HAT-HIL-[0-9]{2}$" },
        "revision": { "const": 1 },
        "status": { "const": "designed_not_implemented" },
        "system_contract_id": { "type": "string", "pattern": "^HR-FR-HIL-[0-9]{2}$" },
        "acceptance_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^HAC-HIL-[0-9]{2}[abc]$" }
        },
        "supporting_test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(HST|HOT)-HIL-[0-9]{2,3}$" }
        },
        "scenario": { "type": "string", "minLength": 1 },
        "required_evidence": { "type": "string", "minLength": 1 },
        "negative_boundary": { "type": "string", "minLength": 1 },
        "semantic_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
